<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="24765" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24743"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="AudioManagerViewController" customModule="Editor_App" customModuleProvider="target">
            <connections>
                <outlet property="addAudioButton" destination="addBtn" id="addConn"/>
                <outlet property="audioNameLabel" destination="audLbl" id="audConn"/>
                <outlet property="muteSwitch" destination="mutSw" id="mutConn"/>
                <outlet property="saveButton" destination="saveBtn" id="saveConn"/>
                <outlet property="titleLabel" destination="titleLbl" id="titleConn"/>
                <outlet property="videoContainerView" destination="vidCnt" id="vidConn"/>
                <outlet property="view" destination="mainView" id="mainConn"/>
                <outlet property="volumeSlider" destination="volSld" id="volConn"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view clearsContextBeforeDrawing="NO" contentMode="scaleToFill" id="mainView">
            <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Audio Manager" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="titleLbl">
                    <rect key="frame" x="16" y="67" width="361" height="22"/>
                    <fontDescription key="fontDescription" type="boldSystem" pointSize="18"/>
                    <nil key="textColor"/>
                    <nil key="highlightedColor"/>
                </label>
                <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="vidCnt" userLabel="VideoContainer">
                    <rect key="frame" x="16" y="105" width="361" height="240"/>
                    <color key="backgroundColor" white="0.0" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                    <constraints>
                        <constraint firstAttribute="height" constant="240" id="vidH"/>
                    </constraints>
                </view>
                <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="16" translatesAutoresizingMaskIntoConstraints="NO" id="cardStack">
                    <rect key="frame" x="16" y="365" width="361" height="190"/>
                    <subviews>
                        <stackView opaque="NO" contentMode="scaleToFill" alignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="muteRow">
                            <rect key="frame" x="0.0" y="0.0" width="361" height="31"/>
                            <subviews>
                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Mute Original Video Audio" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="muteLbl">
                                    <rect key="frame" x="0.0" y="6.6666666666666856" width="312" height="18"/>
                                    <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="15"/>
                                    <nil key="textColor"/>
                                    <nil key="highlightedColor"/>
                                </label>
                                <switch opaque="NO" contentMode="scaleToFill" horizontalHuggingPriority="750" verticalHuggingPriority="750" contentHorizontalAlignment="center" contentVerticalAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="mutSw">
                                    <rect key="frame" x="312" y="0.0" width="51" height="31"/>
                                    <connections>
                                        <action selector="muteSwitchChanged:" destination="-1" eventType="valueChanged" id="mutAct"/>
                                    </connections>
                                </switch>
                            </subviews>
                        </stackView>
                        <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="addBtn">
                            <rect key="frame" x="0.0" y="47" width="361" height="46"/>
                            <color key="backgroundColor" systemColor="systemPurpleColor"/>
                            <constraints>
                                <constraint firstAttribute="height" constant="46" id="addH"/>
                            </constraints>
                            <fontDescription key="fontDescription" type="system" weight="bold" pointSize="15"/>
                            <state key="normal" title="🎵 Add / Replace Audio">
                                <color key="titleColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                            </state>
                            <connections>
                                <action selector="addAudioTapped:" destination="-1" eventType="touchUpInside" id="addAct"/>
                            </connections>
                        </button>
                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="No custom audio selected" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="audLbl">
                            <rect key="frame" x="0.0" y="109" width="361" height="17"/>
                            <fontDescription key="fontDescription" type="system" pointSize="14"/>
                            <color key="textColor" systemColor="secondaryLabelColor"/>
                            <nil key="highlightedColor"/>
                        </label>
                        <stackView opaque="NO" contentMode="scaleToFill" spacing="8" translatesAutoresizingMaskIntoConstraints="NO" id="volRow">
                            <rect key="frame" x="0.0" y="142" width="361" height="48"/>
                            <subviews>
                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Volume:" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="volLbl">
                                    <rect key="frame" x="0.0" y="0.0" width="55" height="48"/>
                                    <fontDescription key="fontDescription" type="system" pointSize="14"/>
                                    <color key="textColor" systemColor="secondaryLabelColor"/>
                                    <nil key="highlightedColor"/>
                                </label>
                                <slider opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" value="1" minValue="0.0" maxValue="1" translatesAutoresizingMaskIntoConstraints="NO" id="volSld">
                                    <rect key="frame" x="61" y="0.0" width="302" height="49"/>
                                    <connections>
                                        <action selector="volumeChanged:" destination="-1" eventType="valueChanged" id="volAct"/>
                                    </connections>
                                </slider>
                            </subviews>
                        </stackView>
                    </subviews>
                </stackView>
                <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="saveBtn">
                    <rect key="frame" x="16" y="748" width="361" height="50"/>
                    <color key="backgroundColor" systemColor="systemBlueColor"/>
                    <constraints>
                        <constraint firstAttribute="height" constant="50" id="saveH"/>
                    </constraints>
                    <fontDescription key="fontDescription" type="system" weight="bold" pointSize="16"/>
                    <state key="normal" title="Save Audio Changes">
                        <color key="titleColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                    </state>
                    <connections>
                        <action selector="saveTapped:" destination="-1" eventType="touchUpInside" id="saveAct"/>
                    </connections>
                </button>
            </subviews>
            <viewLayoutGuide key="safeArea" id="safeArea"/>
            <color key="backgroundColor" systemColor="systemBackgroundColor"/>
            <constraints>
                <constraint firstItem="titleLbl" firstAttribute="top" secondItem="safeArea" secondAttribute="top" constant="8" id="titleT"/>
                <constraint firstItem="titleLbl" firstAttribute="leading" secondItem="safeArea" secondAttribute="leading" constant="16" id="titleL"/>
                <constraint firstItem="safeArea" firstAttribute="trailing" secondItem="titleLbl" secondAttribute="trailing" constant="16" id="titleR"/>
                <constraint firstItem="vidCnt" firstAttribute="top" secondItem="titleLbl" secondAttribute="bottom" constant="16" id="vidT"/>
                <constraint firstItem="vidCnt" firstAttribute="leading" secondItem="safeArea" secondAttribute="leading" constant="16" id="vidL"/>
                <constraint firstItem="safeArea" firstAttribute="trailing" secondItem="vidCnt" secondAttribute="trailing" constant="16" id="vidR"/>
                <constraint firstItem="cardStack" firstAttribute="top" secondItem="vidCnt" secondAttribute="bottom" constant="20" id="cardT"/>
                <constraint firstItem="cardStack" firstAttribute="leading" secondItem="safeArea" secondAttribute="leading" constant="16" id="cardL"/>
                <constraint firstItem="safeArea" firstAttribute="trailing" secondItem="cardStack" secondAttribute="trailing" constant="16" id="cardR"/>
                <constraint firstItem="saveBtn" firstAttribute="leading" secondItem="safeArea" secondAttribute="leading" constant="16" id="saveL"/>
                <constraint firstItem="safeArea" firstAttribute="trailing" secondItem="saveBtn" secondAttribute="trailing" constant="16" id="saveR"/>
                <constraint firstItem="safeArea" firstAttribute="bottom" secondItem="saveBtn" secondAttribute="bottom" constant="20" id="saveB"/>
            </constraints>
            <point key="canvasLocation" x="138" y="154"/>
        </view>
    </objects>
    <resources>
        <systemColor name="secondaryLabelColor">
            <color red="0.23529411764705882" green="0.23529411764705882" blue="0.2627450980392157" alpha="0.59999999999999998" colorSpace="custom" customColorSpace="sRGB"/>
        </systemColor>
        <systemColor name="systemBackgroundColor">
            <color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
        <systemColor name="systemBlueColor">
            <color red="0.0" green="0.47843137250000001" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </systemColor>
        <systemColor name="systemPurpleColor">
            <color red="0.68627450980392157" green="0.32156862745098042" blue="0.87058823529411766" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </systemColor>
    </resources>
</document>
