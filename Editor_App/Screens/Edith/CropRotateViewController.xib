<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="24765" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24743"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="CropRotateViewController" customModule="Editor_App" customModuleProvider="target">
            <connections>
                <outlet property="aspectRatioSegmentedControl" destination="aspSeg" id="aspConn"/>
                <outlet property="backButton" destination="backBtn" id="backConn"/>
                <outlet property="cropButton" destination="crpBtn" id="crpConn"/>
                <outlet property="nextButton" destination="nextBtn" id="nextConn"/>
                <outlet property="rotateButton" destination="rotBtn" id="rotConn"/>
                <outlet property="skipButton" destination="skipBtn" id="skipConn"/>
                <outlet property="stepLabel" destination="stepLbl" id="stepConn"/>
                <outlet property="videoContainerView" destination="vidCnt" id="vidConn"/>
                <outlet property="view" destination="mainView" id="mainConn"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view clearsContextBeforeDrawing="NO" contentMode="scaleToFill" id="mainView">
            <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Step 2 of 5: Crop, Rotate &amp; Aspect Ratio" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="stepLbl">
                    <rect key="frame" x="16" y="67" width="361" height="18"/>
                    <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="15"/>
                    <color key="textColor" systemColor="systemBlueColor"/>
                    <nil key="highlightedColor"/>
                </label>
                <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="vidCnt" userLabel="VideoContainer">
                    <rect key="frame" x="16" y="97" width="361" height="300"/>
                    <color key="backgroundColor" white="0.0" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                    <constraints>
                        <constraint firstAttribute="height" constant="300" id="vidH"/>
                    </constraints>
                </view>
                <stackView opaque="NO" contentMode="scaleToFill" distribution="fillEqually" spacing="12" translatesAutoresizingMaskIntoConstraints="NO" id="toolStack">
                    <rect key="frame" x="16" y="413" width="361" height="44"/>
                    <subviews>
                        <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="crpBtn">
                            <rect key="frame" x="0.0" y="0.0" width="174.66666666666666" height="44"/>
                            <color key="backgroundColor" systemColor="systemTealColor"/>
                            <fontDescription key="fontDescription" type="system" weight="bold" pointSize="15"/>
                            <state key="normal" title="✂️ Crop Video">
                                <color key="titleColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                            </state>
                            <connections>
                                <action selector="cropTapped:" destination="-1" eventType="touchUpInside" id="crpAct"/>
                            </connections>
                        </button>
                        <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="rotBtn">
                            <rect key="frame" x="186.66666666666663" y="0.0" width="174.33333333333337" height="44"/>
                            <color key="backgroundColor" systemColor="systemBlueColor"/>
                            <fontDescription key="fontDescription" type="system" weight="bold" pointSize="15"/>
                            <state key="normal" title="🔄 Rotate 90°">
                                <color key="titleColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                            </state>
                            <connections>
                                <action selector="rotateTapped:" destination="-1" eventType="touchUpInside" id="rotAct"/>
                            </connections>
                        </button>
                    </subviews>
                    <constraints>
                        <constraint firstAttribute="height" constant="44" id="toolH"/>
                    </constraints>
                </stackView>
                <segmentedControl opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="left" contentVerticalAlignment="top" segmentControlStyle="plain" selectedSegmentIndex="0" translatesAutoresizingMaskIntoConstraints="NO" id="aspSeg">
                    <rect key="frame" x="16" y="473" width="361" height="36"/>
                    <constraints>
                        <constraint firstAttribute="height" constant="35" id="aspH"/>
                    </constraints>
                    <segments>
                        <segment title="Original"/>
                        <segment title="16:9"/>
                        <segment title="9:16"/>
                        <segment title="1:1"/>
                        <segment title="4:5"/>
                    </segments>
                </segmentedControl>
                <stackView opaque="NO" contentMode="scaleToFill" distribution="fillEqually" spacing="12" translatesAutoresizingMaskIntoConstraints="NO" id="navStack">
                    <rect key="frame" x="16" y="756" width="361" height="48"/>
                    <subviews>
                        <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="backBtn">
                            <rect key="frame" x="0.0" y="0.0" width="112.33333333333333" height="48"/>
                            <color key="backgroundColor" systemColor="secondarySystemFillColor"/>
                            <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="15"/>
                            <state key="normal" title="Back">
                                <color key="titleColor" systemColor="labelColor"/>
                            </state>
                            <connections>
                                <action selector="backTapped:" destination="-1" eventType="touchUpInside" id="backAct"/>
                            </connections>
                        </button>
                        <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="skipBtn">
                            <rect key="frame" x="124.33333333333334" y="0.0" width="112.33333333333334" height="48"/>
                            <color key="backgroundColor" systemColor="tertiarySystemFillColor"/>
                            <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="15"/>
                            <state key="normal" title="Skip">
                                <color key="titleColor" systemColor="labelColor"/>
                            </state>
                            <connections>
                                <action selector="skipTapped:" destination="-1" eventType="touchUpInside" id="skipAct"/>
                            </connections>
                        </button>
                        <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="nextBtn">
                            <rect key="frame" x="248.66666666666666" y="0.0" width="112.33333333333334" height="48"/>
                            <color key="backgroundColor" systemColor="systemBlueColor"/>
                            <fontDescription key="fontDescription" type="system" weight="bold" pointSize="15"/>
                            <state key="normal" title="Next">
                                <color key="titleColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                            </state>
                            <connections>
                                <action selector="nextTapped:" destination="-1" eventType="touchUpInside" id="nextAct"/>
                            </connections>
                        </button>
                    </subviews>
                    <constraints>
                        <constraint firstAttribute="height" constant="48" id="navH"/>
                    </constraints>
                </stackView>
            </subviews>
            <viewLayoutGuide key="safeArea" id="safeArea"/>
            <color key="backgroundColor" systemColor="systemBackgroundColor"/>
            <constraints>
                <constraint firstItem="stepLbl" firstAttribute="top" secondItem="safeArea" secondAttribute="top" constant="8" id="stepT"/>
                <constraint firstItem="stepLbl" firstAttribute="leading" secondItem="safeArea" secondAttribute="leading" constant="16" id="stepL"/>
                <constraint firstItem="safeArea" firstAttribute="trailing" secondItem="stepLbl" secondAttribute="trailing" constant="16" id="stepR"/>
                <constraint firstItem="vidCnt" firstAttribute="top" secondItem="stepLbl" secondAttribute="bottom" constant="12" id="vidT"/>
                <constraint firstItem="vidCnt" firstAttribute="leading" secondItem="safeArea" secondAttribute="leading" constant="16" id="vidL"/>
                <constraint firstItem="safeArea" firstAttribute="trailing" secondItem="vidCnt" secondAttribute="trailing" constant="16" id="vidR"/>
                <constraint firstItem="toolStack" firstAttribute="top" secondItem="vidCnt" secondAttribute="bottom" constant="16" id="toolT"/>
                <constraint firstItem="toolStack" firstAttribute="leading" secondItem="safeArea" secondAttribute="leading" constant="16" id="toolL"/>
                <constraint firstItem="safeArea" firstAttribute="trailing" secondItem="toolStack" secondAttribute="trailing" constant="16" id="toolR"/>
                <constraint firstItem="aspSeg" firstAttribute="top" secondItem="toolStack" secondAttribute="bottom" constant="16" id="aspT"/>
                <constraint firstItem="aspSeg" firstAttribute="leading" secondItem="safeArea" secondAttribute="leading" constant="16" id="aspL"/>
                <constraint firstItem="safeArea" firstAttribute="trailing" secondItem="aspSeg" secondAttribute="trailing" constant="16" id="aspR"/>
                <constraint firstItem="navStack" firstAttribute="leading" secondItem="safeArea" secondAttribute="leading" constant="16" id="navL"/>
                <constraint firstItem="safeArea" firstAttribute="trailing" secondItem="navStack" secondAttribute="trailing" constant="16" id="navR"/>
                <constraint firstItem="safeArea" firstAttribute="bottom" secondItem="navStack" secondAttribute="bottom" constant="14" id="navB"/>
            </constraints>
            <point key="canvasLocation" x="138" y="154"/>
        </view>
    </objects>
    <resources>
        <systemColor name="labelColor">
            <color white="0.0" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
        <systemColor name="secondarySystemFillColor">
            <color red="0.47058823529411764" green="0.47058823529411764" blue="0.50196078431372548" alpha="0.20000000000000001" colorSpace="custom" customColorSpace="sRGB"/>
