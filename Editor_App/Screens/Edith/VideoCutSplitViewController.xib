                <constraint firstItem="timeLbl" firstAttribute="leading" secondItem="safeArea" secondAttribute="leading" constant="16" id="timeL"/>
                <constraint firstItem="safeArea" firstAttribute="trailing" secondItem="timeLbl" secondAttribute="trailing" constant="16" id="timeR"/>
