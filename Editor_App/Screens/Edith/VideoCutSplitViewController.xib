                            </state>
                            <connections>
                                <action selector="backTapped:" destination="-1" eventType="touchUpInside" id="backAct"/>
                            </connections>
                        </button>
                        <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="skipBtn">
                            <rect key="frame" x="124.33333333333334" y="0.0" width="112.33333333333334" height="48"/>
                            <color key="backgroundColor" systemColor="tertiarySystemFillColor"/>
                            <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="15"/>
                            <state key="normal" title="Skip">
                                <color key="titleColor" systemColor="labelColor"/>
                            </state>
                            <connections>
                                <action selector="skipTapped:" destination="-1" eventType="touchUpInside" id="skipAct"/>
                            </connections>
                        </button>
                        <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="nextBtn">
                            <rect key="frame" x="248.66666666666666" y="0.0" width="112.33333333333334" height="48"/>
                            <color key="backgroundColor" systemColor="systemBlueColor"/>
                            <fontDescription key="fontDescription" type="system" weight="bold" pointSize="15"/>
                            <state key="normal" title="Next">
                                <color key="titleColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                            </state>
                            <connections>
                                <action selector="nextTapped:" destination="-1" eventType="touchUpInside" id="nextAct"/>
                            </connections>
                        </button>
                    </subviews>
                    <constraints>
                        <constraint firstAttribute="height" constant="48" id="navH"/>
                    </constraints>
                </stackView>
            </subviews>
            <viewLayoutGuide key="safeArea" id="safeArea"/>
            <color key="backgroundColor" systemColor="systemBackgroundColor"/>
            <constraints>
                <constraint firstItem="stepLbl" firstAttribute="top" secondItem="safeArea" secondAttribute="top" constant="8" id="stepT"/>
                <constraint firstItem="stepLbl" firstAttribute="leading" secondItem="safeArea" secondAttribute="leading" constant="16" id="stepL"/>
                <constraint firstItem="safeArea" firstAttribute="trailing" secondItem="stepLbl" secondAttribute="trailing" constant="16" id="stepR"/>
                <constraint firstItem="vidCnt" firstAttribute="top" secondItem="stepLbl" secondAttribute="bottom" constant="12" id="vidT"/>
                <constraint firstItem="vidCnt" firstAttribute="leading" secondItem="safeArea" secondAttribute="leading" constant="16" id="vidL"/>
                <constraint firstItem="safeArea" firstAttribute="trailing" secondItem="vidCnt" secondAttribute="trailing" constant="16" id="vidR"/>
